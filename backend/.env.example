# Vertex AI requires an enabled API, billing, and Application Default Credentials.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# Optional: keep service-account files outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Diagnostic checks include a billable image-generation request. Disabled at startup.
RUN_STARTUP_DIAGNOSTICS=false
